{
  "expo": {
    "name": "Pendi Drama",
    "slug": "pendi-drama",
    "version": "1.0.0",
    "runtimeVersion": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pendi-drama",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#080c10"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pendi.drama"
    },
    "android": {
      "package": "com.pendi.drama",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#080c10"
      }
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-video"
    ],
    "updates": {
      "url": "https://u.expo.dev/9e4ee909-016a-4b39-a646-a3b4160f1d67",
      "enabled": true,
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "9e4ee909-016a-4b39-a646-a3b4160f1d67"
      }
    },
    "owner": "pendi28"
  }
}
